# =================================================================
# KINTAI Quality Pipeline - Environment Configuration Template
# =================================================================

# Priority 1: Remote Ollama Host (Accelerated RTX 5070 Ti)
# Set your Tailscale / LAN IP or hostname for Ollama GPU server:
# OLLAMA_REMOTE_HOST=your-remote-tailscale-ip-here

# Host override parameter for local/custom endpoint redirection
# OLLAMA_HOST_OVERRIDE=http://127.0.0.1:11434

# Sensitive keywords pattern for leak verification scanner (pipe-separated)
# AUDIT_SENSITIVE_KEYWORDS=secret_key|private_token

# Optional: Default target execution model
# OLLAMA_DEFAULT_MODEL=qwen3.8:27b
